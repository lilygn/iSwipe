{
  "expo": {
    "name": "IlliniFindr",
    "slug": "illini-findr",
    "owner": "lilygniedz",
    "privacy": "public",
    "platforms": ["ios", "android", "web"],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6955820a-9eb8-4350-a0c9-f165845f0d9c"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lily.RSOSwiper",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.lily.RSOSwiper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/images/icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#ffffff" }],
      "expo-font"
    ],

    "experiments": { "typedRoutes": true },
    "extra": { "router": {}, "eas": { "projectId": "6955820a-9eb8-4350-a0c9-f165845f0d9c" } }
  }
}
